---
import { faqs, site, whatsappUrl } from "../data/site";
---

<section id="preguntas" class="section section--white">
  <div class="container inner">
    <div class="heading intro">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2 class="h2">Lo que todos preguntan</h2>
      <p class="lead">
        ¿Te quedó alguna duda? Escríbenos por <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener">WhatsApp</a
        >.
      </p>
    </div>
    <div class="list">
      {
        faqs.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              {f.q}
              <span class="sign" aria-hidden="true" />
            </summary>
            <p>
              {f.a}
              {f.pending && (
                <>
                  {" "}
                  <span class="tbd">{f.pending}</span>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .inner {
    display: flex;
    gap: 72px;
    align-items: flex-start;
  }
  .intro {
    width: 380px;
    flex-shrink: 0;
  }
  .intro a {
    font-weight: 600;
    white-space: nowrap;
  }
  .list {
    flex-grow: 1;
    min-width: 0;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    min-height: 68px;
    padding: 18px 0;
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: clamp(17px, 0.5vw + 14px, 19px);
    font-weight: 600;
    color: var(--ink);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .sign {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: var(--accent-strong);
  }
  .sign::before {
    content: "+";
  }
  details[open] .sign::before {
    content: "−";
  }
  details p {
    padding: 0 56px 22px 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .tbd {
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--amber-soft);
    color: var(--amber-ink);
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .inner {
      flex-direction: column;
      gap: 32px;
    }
    .intro {
      width: 100%;
    }
    .list {
      width: 100%;
    }
  }
  @media (max-width: 560px) {
    details p {
      padding-right: 0;
    }
  }
</style>
