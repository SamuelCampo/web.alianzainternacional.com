---
const items = [
  { title: 'Inicial fija de 45%', text: 'No depende de niveles ni de historial. Todos empiezan igual.', icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 3v9h9"></path>' },
  { title: 'Tú eliges el ritmo', text: '4 cuotas semanales o 2 quincenales. El total es el mismo.', icon: '<rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M3 10h18"></path><path d="M8 3v4"></path><path d="M16 3v4"></path>' },
  { title: 'Pagas como ya pagas', text: 'Pago Móvil o transferencia. Subes el comprobante y listo.', icon: '<rect x="6" y="2" width="12" height="20" rx="3"></rect><path d="M11 18h2"></path>' },
  { title: 'Todo a la vista', text: 'Tu pedido, tus cuotas y tu próximo pago, siempre en la app.', icon: '<path d="M4 7h16"></path><path d="M4 12h10"></path><path d="M4 17h7"></path><path d="M16 16l2 2 4-4"></path>' },
];
---

<section class="benefits">
  <div class="container">
    <ul class="grid">
      {items.map((item) => (
        <li>
          <span class="icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .benefits { padding-bottom: clamp(64px, 8vw, 96px); }
  /* El gap de 1px sobre fondo gris dibuja los divisores en cualquier número de columnas. */
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: 24px; overflow: hidden;
  }
  li { padding: 32px 28px; display: flex; flex-direction: column; gap: 12px; background: var(--surface); }
  .icon { width: 48px; height: 48px; border-radius: 14px; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; }
  h3 { font-size: 20px; font-weight: 700; }
  p { font-size: 16px; line-height: 1.5; color: var(--ink-2); }

  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    li { padding: 24px; }
  }
</style>
